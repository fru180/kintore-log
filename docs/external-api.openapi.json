{
  "openapi": "3.1.0",
  "info": {
    "title": "筋トレログ 外部読み取りAPI",
    "version": "2.0.0",
    "description": "OAuth Authorization Code + PKCE S256必須。取得は本人の記録に限定。筋トレ・有酸素の推移と体組成の推移は別API。体重kg、身長cm、体脂肪率%、筋肉量kg、基礎代謝量kcal/日。旧 /body-weights は廃止。/stats は運動推移のみ返す。"
  },
  "servers": [
    {
      "url": "https://curiosk.com/kintore-log/api/v1"
    }
  ],
  "security": [
    {
      "oauth": [
        "workouts:read"
      ]
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "接続先の本人情報",
        "responses": {
          "200": {
            "description": "本人情報",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "accountName"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "accountName": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/records": {
      "get": {
        "operationId": "getRecords",
        "summary": "指定日または期間内の運動記録を日付単位で取得",
        "description": "dateで1日、またはfrom/toの両端を含む最大366日を指定。併用不可。期間指定は日付昇順のdays配列を返し、未記録の日も含む。各日について現在登録されている全種目を表示順・ID順に一度に返す。limit/cursorによる分割はしない。recordedは本人の保存済み記録の有無。0kgの記録はtrue、未記録はfalse・idと全数値項目はnull。",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD形式の実在する日付。date単独、またはfrom/toのペアが必須。同時指定不可。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "期間の開始日（含む）。toも必須。dateとの併用不可。両端を含め最大366日。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "期間の終了日（含む）。fromも必須。from以上の日付。dateとの併用不可。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "date指定はRecordDay、from/to指定はRecordRange。各日の全種目を返し、ページング・件数打ち切りはない。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RecordDay"
                    },
                    {
                      "$ref": "#/components/schemas/RecordRange"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/exercises": {
      "get": {
        "operationId": "listExercises",
        "summary": "共通種目一覧と本人の重量アップ候補設定",
        "responses": {
          "200": {
            "description": "種目一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "exercises"
                  ],
                  "properties": {
                    "exercises": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Exercise"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/stats": {
      "get": {
        "operationId": "getExerciseStats",
        "summary": "指定種目の筋トレ・有酸素運動の推移",
        "description": "exerciseIdとfrom/toが必須。両端を含む最大366日。本人の指定種目の保存済み記録だけを日付昇順で全件返す。未記録の日は省略。0kgと補助重量の負値はそのまま返す。有酸素はdistanceKmとdurationMinutesを返す。存在しない種目・記録がない種目のexerciseは空配列。体組成は含めず、/body-composition/statsで別途取得する。ページングなし。",
        "parameters": [
          {
            "name": "exerciseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "description": "/exercisesで取得した種目ID。正の整数。"
          },
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "200": {
            "description": "指定種目の推移のみ。bodyWeightsは廃止。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "exercise"
                  ],
                  "properties": {
                    "exercise": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExerciseStatPoint"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/body-composition": {
      "get": {
        "operationId": "getBodyComposition",
        "summary": "指定日または期間内の体組成全7項目を日付単位で取得",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD形式の実在する日付。date単独、またはfrom/toのペアが必須。同時指定不可。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "期間の開始日（含む）。toも必須。dateとの併用不可。両端を含め最大366日。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "期間の終了日（含む）。fromも必須。from以上の日付。dateとの併用不可。",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "date指定はBodyCompositionDay、期間指定はBodyCompositionRange。未記録日も全7項目を返す。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BodyCompositionDay"
                    },
                    {
                      "$ref": "#/components/schemas/BodyCompositionRange"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "date単独、またはfrom/toのペアを指定。併用不可。期間指定は両端を含む最大366日。全日を昇順のdaysに含め、未記録項目はnull。日付ごとに体組成全7項目をまとめて返す。入力欄用の初期値は含めない。BMIは体重または身長の記録日に当日以前の最新保存値で計算し、小数第1位まで返す。両方がそろわなければnull。ページングなし。"
      }
    },
    "/body-composition/stats": {
      "get": {
        "operationId": "getBodyCompositionStats",
        "summary": "体組成全7項目の推移を取得",
        "description": "from/to必須、両端を含む最大366日。本人の記録がある日のみを日付昇順で返す。各点はdateと全7項目を持ち、当日にない値はnull。BMIのみ当日以前の最新の体重・身長で計算する（期間開始前の記録も参照）。体重または身長の記録日だけ計算し、両方がそろわなければnull。過去記録の更新・削除も計算に反映する。種目ID・項目選択不要。ページングなし。",
        "parameters": [
          {
            "$ref": "#/components/parameters/From"
          },
          {
            "$ref": "#/components/parameters/To"
          }
        ],
        "responses": {
          "200": {
            "description": "記録日の全7項目。記録がなければbodyCompositionは空配列。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "bodyComposition"
                  ],
                  "properties": {
                    "bodyComposition": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BodyCompositionStatPoint"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "description": "PKCE S256必須。クライアントは管理者が登録。公開クライアントはnone、秘密を保持できるクライアントはclient_secret_basic。",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://curiosk.com/kintore-log/oauth/authorize",
            "tokenUrl": "https://curiosk.com/kintore-log/oauth/token",
            "refreshUrl": "https://curiosk.com/kintore-log/oauth/token",
            "scopes": {
              "workouts:read": "本人の筋トレ・有酸素記録、体重、種目一覧と重量アップ候補設定の読み取り"
            }
          }
        }
      }
    },
    "parameters": {
      "From": {
        "name": "from",
        "in": "query",
        "required": true,
        "description": "開始日（含む）。toまで最大366日。",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "To": {
        "name": "to",
        "in": "query",
        "required": true,
        "description": "終了日（含む）。from以降。",
        "schema": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "入力・認証・権限・レート制限・停止等のエラー。詳細はステータスとcodeで判定。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "required": [
          "id",
          "exerciseId",
          "date",
          "weightKg",
          "reps",
          "sets",
          "distanceKm",
          "durationMinutes",
          "name",
          "kind",
          "recorded"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "保存済みの記録ID。未記録はnull。"
          },
          "exerciseId": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "weightKg": {
            "type": [
              "number",
              "null"
            ],
            "description": "kg。補助重量などの負値を含む。"
          },
          "reps": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sets": {
            "type": [
              "integer",
              "null"
            ],
            "description": "同一重量・回数として記録されたセット数"
          },
          "distanceKm": {
            "type": [
              "number",
              "null"
            ],
            "description": "km"
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "分"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "strength",
              "cardio"
            ]
          },
          "recorded": {
            "type": "boolean",
            "description": "指定日に本人の記録が保存されているか。falseは未記録。実際の未実施を断定しない。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "recorded": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "id": {
                  "type": "null"
                },
                "weightKg": {
                  "type": "null"
                },
                "reps": {
                  "type": "null"
                },
                "sets": {
                  "type": "null"
                },
                "distanceKm": {
                  "type": "null"
                },
                "durationMinutes": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "id": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      },
      "Exercise": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "sortOrder",
          "readyForWeightIncrease"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "strength",
              "cardio"
            ]
          },
          "sortOrder": {
            "type": "integer"
          },
          "readyForWeightIncrease": {
            "type": "boolean"
          }
        }
      },
      "RecordDay": {
        "type": "object",
        "required": [
          "date",
          "records"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        }
      },
      "RecordRange": {
        "type": "object",
        "required": [
          "from",
          "to",
          "days"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "minItems": 1,
            "maxItems": 366,
            "description": "期間内の全日を日付昇順で返す。各日の全種目を含み、未記録の日も省略しない。",
            "items": {
              "$ref": "#/components/schemas/RecordDay"
            }
          }
        }
      },
      "ExerciseStatPoint": {
        "type": "object",
        "required": [
          "date",
          "weightKg",
          "reps",
          "sets",
          "distanceKm",
          "durationMinutes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "weightKg": {
            "type": [
              "number",
              "null"
            ],
            "description": "kg。補助重量などの負値を含む。"
          },
          "reps": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sets": {
            "type": [
              "integer",
              "null"
            ],
            "description": "同一重量・回数として記録されたセット数"
          },
          "distanceKm": {
            "type": [
              "number",
              "null"
            ],
            "description": "km"
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "分"
          }
        }
      },
      "BodyComposition": {
        "type": "object",
        "required": [
          "weightKg",
          "heightCm",
          "bmi",
          "bodyFatPercent",
          "muscleMassKg",
          "visceralFatLevel",
          "basalMetabolismKcal"
        ],
        "properties": {
          "weightKg": {
            "type": [
              "number",
              "null"
            ],
            "description": "体重（kg）。当日の保存値。 未記録・計算不可はnull。"
          },
          "heightCm": {
            "type": [
              "number",
              "null"
            ],
            "description": "身長（cm）。当日の保存値。 未記録・計算不可はnull。"
          },
          "bmi": {
            "type": [
              "number",
              "null"
            ],
            "description": "体重kg ÷ (身長cm ÷ 100)²。体重または身長の記録日に、その日以前の最新値から計算した小数第1位までの値。 未記録・計算不可はnull。"
          },
          "bodyFatPercent": {
            "type": [
              "number",
              "null"
            ],
            "description": "体脂肪率（%）。0%も記録値。 未記録・計算不可はnull。"
          },
          "muscleMassKg": {
            "type": [
              "number",
              "null"
            ],
            "description": "筋肉量（kg）。 未記録・計算不可はnull。"
          },
          "visceralFatLevel": {
            "type": [
              "number",
              "null"
            ],
            "description": "内臓脂肪レベル。 未記録・計算不可はnull。"
          },
          "basalMetabolismKcal": {
            "type": [
              "number",
              "null"
            ],
            "description": "基礎代謝量（kcal/日）。 未記録・計算不可はnull。"
          }
        }
      },
      "BodyCompositionDay": {
        "type": "object",
        "required": [
          "date",
          "bodyComposition"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "bodyComposition": {
            "$ref": "#/components/schemas/BodyComposition"
          }
        }
      },
      "BodyCompositionRange": {
        "type": "object",
        "required": [
          "from",
          "to",
          "days"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "minItems": 1,
            "maxItems": 366,
            "description": "期間内の全日を昇順で返す。未記録日も全項目nullで含める。",
            "items": {
              "$ref": "#/components/schemas/BodyCompositionDay"
            }
          }
        }
      },
      "BodyCompositionStatPoint": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BodyComposition"
          },
          {
            "type": "object",
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      }
    }
  }
}
